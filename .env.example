# Copy to .env and change. Never commit .env.
ERP_JWT_SECRET=replace-with-64-random-characters
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
ERP_ADMIN_PASSWORD=

# WhatsApp Business Platform (Meta Cloud API) — for automatic balance reminders.
# Token: Meta Business Settings → Users → System users → Generate new token (permission whatsapp_business_messaging).
# Phone number ID: WhatsApp Manager / developers.facebook.com → your app → WhatsApp → API Setup.
ERP_WHATSAPP_TOKEN=
ERP_WHATSAPP_PHONE_NUMBER_ID=
